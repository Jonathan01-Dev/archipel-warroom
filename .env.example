# Copie ce fichier en .env.local et remplis les valeurs


# Permissions nécessaires : Contents (read), Metadata (read)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Durée du hackathon en minutes (ex: 480 = 8h)
HACKATHON_DURATION_MINUTES=1500

# Date/heure de départ au format ISO (ex: 2024-06-01T09:00:00)
HACKATHON_START_TIME=2026-02-27T15:00:00

# Clé secrète pour protéger l'API admin (change ça !)
ADMIN_SECRET=change-moi-en-prod
